<Grid x:Name="MainColumns"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="230" MinWidth="160"/><ColumnDefinition x:Name="MailColumn" Width="340" MinWidth="250"/><ColumnDefinition x:Name="ReadingColumn" Width="*" MinWidth="220"/><ColumnDefinition x:Name="AiColumn" Width="320"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{ThemeResource SidebarBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0"><Grid Padding="16,16,16,20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
<StackPanel Orientation="Horizontal" Spacing="10" Margin="4,0,0,0"><Image Source="ms-appx:///Assets/MailMind.png" Width="42" Height="42"/><StackPanel VerticalAlignment="Center"><TextBlock Text="智邮" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource HeadingBrush}"/><TextBlock Text="让邮件回归清晰" FontSize="11" Foreground="{ThemeResource MutedBrush}"/></StackPanel></StackPanel>
<Grid x:Name="DragRegion" Background="Transparent"/>
<Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8"><Button Content="✎  写邮件" Click="Compose_Click" Background="#2863CF" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,6" FontSize="16"/><Button Grid.Column="1" Content="⟳" Click="Refresh_Click" Background="Transparent" BorderThickness="0" FontSize="26" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新"><Button.Template><ControlTemplate TargetType="Button"><ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" Padding="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></ControlTemplate></Button.Template></Button></Grid>
<ScrollViewer Grid.Row="2" Margin="0,0,-12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><StackPanel HorizontalAlignment="Stretch" Margin="0,0,12,0"><TextBlock x:Name="NoAccountHint" Text="尚未添加邮箱" Foreground="{ThemeResource MutedBrush}"/><Expander x:Name="AccountExpander" Visibility="Collapsed" IsExpanded="True" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><Expander.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="●" Foreground="#48B84B"/><TextBlock x:Name="AccountLabel" Text="尚未连接邮箱" MaxWidth="150" TextTrimming="CharacterEllipsis"/></StackPanel></Expander.Header><StackPanel x:Name="FolderList" Spacing="2" HorizontalAlignment="Stretch"/></Expander></StackPanel></ScrollViewer>
<Button Grid.Row="3" Style="{StaticResource SidebarButtonStyle}" Click="Settings_Click" Content="⚙   配置" HorizontalAlignment="Stretch"/>
</Grid></Border>
<Border Grid.Column="1" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0" Background="{ThemeResource PanelBrush}"><Grid RowDefinitions="Auto,Auto,*"><Grid Padding="12,16" ColumnDefinitions="*,40,70" ColumnSpacing="6"><Grid><TextBox x:Name="SearchBox" PlaceholderText="搜索邮件" Padding="34,8,8,8" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Height="40" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" AutomationProperties.Name="搜索邮件"/><FontIcon Glyph="&#xE721;" FontSize="15" Foreground="{ThemeResource SecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/></Grid><Button x:Name="DateFilterButton" Grid.Column="1" Width="40" Height="40" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTipService.ToolTip="按日期筛选已加载邮件" AutomationProperties.Name="按日期筛选邮件"><FontIcon Glyph="&#xE787;" FontSize="17"/><Button.Flyout><Flyout Placement="Bottom"><StackPanel Spacing="8"><TextBlock Text="选择邮件日期" FontWeight="SemiBold"/><CalendarView x:Name="SearchCalendar" SelectionMode="Single" SelectedDatesChanged="SearchCalendar_SelectedDatesChanged"/><Button Content="清除日期筛选" Click="ClearDateFilter_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/></StackPanel></Flyout></Button.Flyout></Button><ToggleButton x:Name="AiSearchButton" Grid.Column="2" Width="70" Height="40" Padding="0" Checked="AiSearchModeChanged" Unchecked="AiSearchModeChanged" ToolTipService.ToolTip="切换 AI 搜索；输入问题后按回车" AutomationProperties.Name="AI 搜索"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{ThemeResource ToggleBackgroundBrush}" BorderBrush="{ThemeResource ToggleBorderBrush}" BorderThickness="1" CornerRadius="7"><ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template><StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="AI" FontWeight="SemiBold" Foreground="{ThemeResource HeadingBrush}"/><Grid Width="28" Height="16"><Border x:Name="AiSwitchTrack" Background="#C8D1DE" CornerRadius="8"/><Ellipse x:Name="AiSwitchThumb" Width="12" Height="12" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0"/></Grid></StackPanel></ToggleButton></Grid><StackPanel Grid.Row="1" Background="{ThemeResource GroupBrush}" Padding="14,7"><Grid x:Name="AiSearchStatusPanel" Visibility="Collapsed" ColumnDefinitions="*,Auto" Margin="0,0,0,6"><TextBlock x:Name="AiSearchStatus" TextWrapping="Wrap" Foreground="{ThemeResource AccentTextBrush}" FontSize="12" VerticalAlignment="Center"/><Button x:Name="AiSearchStopButton" Grid.Column="1" Content="中止" Click="AiSearchStop_Click" Padding="8,2"/></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="FolderTitle" Text="收件箱" Foreground="{ThemeResource SecondaryBrush}" VerticalAlignment="Center"/><Button x:Name="ClearSearchButton" Grid.Column="1" Visibility="Collapsed" Content="清除筛选" Click="ClearSearch_Click" Padding="8,2" ToolTipService.ToolTip="清除搜索和日期筛选，显示所有邮件"/></Grid><TextBlock x:Name="ListStatus" Text="连接邮箱后查看邮件" Foreground="{ThemeResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/></StackPanel><Grid Grid.Row="2"><ListView x:Name="MailList" SelectionChanged="MailList_SelectionChanged" Loaded="MailList_Loaded" LayoutUpdated="MailList_LayoutUpdated" SizeChanged="MailList_SizeChanged" ContainerContentChanging="MailList_ContainerContentChanging" HorizontalContentAlignment="Stretch"><ListView.GroupStyle><GroupStyle><GroupStyle.HeaderContainerStyle><Style TargetType="ListViewHeaderItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewHeaderItem"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Stretch"/></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.HeaderContainerStyle><GroupStyle.HeaderTemplate><DataTemplate><Border Background="{ThemeResource GroupBrush}" Padding="14,7" HorizontalAlignment="Stretch"><TextBlock Text="{Binding Title}" Foreground="{ThemeResource SecondaryBrush}" FontSize="12"/></Border></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListView.GroupStyle><ListView.Template><ControlTemplate TargetType="ListView"><ScrollViewer VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" Loaded="MailScroll_Loaded" ViewChanged="ListScroll_ViewChanged"><ItemsPresenter/></ScrollViewer></ControlTemplate></ListView.Template><ListView.ItemTemplate><DataTemplate><Grid Padding="4,10" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8"><Ellipse Width="8" Height="8" Fill="#2863CF" VerticalAlignment="Top" Margin="0,8,0,0" Visibility="{Binding UnreadVisibility}"/><StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Top" HorizontalAlignment="Center"><Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource IconBackgroundBrush}"><FontIcon Glyph="&#xE715;" FontSize="16" Foreground="{ThemeResource AccentTextBrush}"/></Border><Border Background="{Binding ImportanceBrush}" Visibility="{Binding ImportanceVisibility}" CornerRadius="10" Padding="6,2" HorizontalAlignment="Center" ToolTipService.ToolTip="AI 判断的邮件重要性"><StackPanel Orientation="Horizontal" Spacing="3"><TextBlock Text="AI" Foreground="White" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="{Binding Importance}" Foreground="White" FontSize="10" TextAlignment="Center" VerticalAlignment="Center"/></StackPanel></Border></StackPanel><StackPanel Grid.Column="2" Spacing="4"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6"><TextBlock Text="{Binding DisplaySender}" FontWeight="{Binding MailWeight}" TextTrimming="CharacterEllipsis"/><FontIcon Grid.Column="1" Glyph="&#xE723;" FontSize="13" Foreground="{ThemeResource MutedBrush}" Visibility="{Binding AttachmentVisibility}" ToolTipService.ToolTip="含附件" AutomationProperties.Name="含附件"/><TextBlock Grid.Column="2" Text="{Binding Date}" FontSize="11" Foreground="{ThemeResource MutedBrush}"/></Grid><TextBlock Text="{Binding Subject}" FontWeight="{Binding MailWeight}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Preview}" Foreground="{ThemeResource MutedBrush}" FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView><TextBlock x:Name="ListEmptyText" Text="还没有邮件" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource MutedBrush}"/></Grid></Grid></Border>
<Grid Grid.Column="2" RowDefinitions="Auto,*"><Border x:Name="ReadingToolbar" Visibility="Collapsed" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1" Padding="18,20,18,12"><ItemsControl><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.Items><Button Width="112" Click="Reply_Click" Style="{StaticResource ReadingActionStyle}" AutomationProperties.Name="回复"><StackPanel Orientation="Horizontal" Spacing="8"><Viewbox Width="20" Height="20"><Canvas Width="20" Height="20"><Path Data="M 9,4 L 3,9 L 9,14 M 3,9 L 10,9 C 15,9 18,11 19,16" Stroke="{ThemeResource SecondaryBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="回复" VerticalAlignment="Center" Foreground="{ThemeResource HeadingBrush}"/></StackPanel></Button><Button Width="112" Click="ReplyAll_Click" Style="{StaticResource ReadingActionStyle}" AutomationProperties.Name="全部回复"><StackPanel Orientation="Horizontal" Spacing="8"><Viewbox Width="20" Height="20"><Canvas Width="20" Height="20"><Path Data="M 8,4 L 2,9 L 8,14 M 13,4 L 7,9 L 13,14 M 7,9 L 12,9 C 16,9 19,11 20,16" Stroke="{ThemeResource SecondaryBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="全部回复" VerticalAlignment="Center" Foreground="{ThemeResource HeadingBrush}"/></StackPanel></Button><Button Width="112" IsEnabled="False" Style="{StaticResource ReadingActionStyle}" AutomationProperties.Name="转发"><StackPanel Orientation="Horizontal" Spacing="8"><Viewbox Width="20" Height="20"><Canvas Width="20" Height="20"><Path Data="M 11,4 L 17,9 L 11,14 M 17,9 L 10,9 C 5,9 2,11 1,16" Stroke="{ThemeResource SecondaryBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="转发" VerticalAlignment="Center" Foreground="{ThemeResource HeadingBrush}"/></StackPanel></Button><Button Width="112" IsEnabled="False" Style="{StaticResource ReadingActionStyle}" AutomationProperties.Name="删除"><StackPanel Orientation="Horizontal" Spacing="8"><Viewbox Width="20" Height="20"><Canvas Width="20" Height="20"><Path Data="M 4,5 L 16,5 M 8,3 L 12,3 M 5,5 L 6,18 L 14,18 L 15,5 M 9,8 L 9,15 M 11,8 L 11,15" Stroke="{ThemeResource SecondaryBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="删除" VerticalAlignment="Center" Foreground="{ThemeResource HeadingBrush}"/></StackPanel></Button></ItemsControl.Items></ItemsControl></Border>
<StackPanel x:Name="EmptyWorkspace" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16"><FontIcon Glyph="&#xE715;" FontSize="64" Foreground="{ThemeResource SubtleIconBrush}" HorizontalAlignment="Center"/><TextBlock Text="选择一封邮件开始阅读" FontSize="20" Foreground="{ThemeResource EmptyTextBrush}"/><Button Content="✎  写邮件" Click="Compose_Click" Background="#2863CF" Foreground="White" HorizontalAlignment="Center"/></StackPanel>
<Grid x:Name="ReadingWorkspace" Grid.Row="1" Visibility="Collapsed" Padding="24,24,24,12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
<TextBlock x:Name="ReadSubject" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
<StackPanel Grid.Row="1" Spacing="8"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Border Width="46" Height="46" CornerRadius="23" Background="#477FD0" VerticalAlignment="Top"><FontIcon Glyph="&#xE77B;" Foreground="White" FontSize="20"/></Border><StackPanel Grid.Column="1" Spacing="4"><TextBlock TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"><Run x:Name="ReadSenderName" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource HeadingBrush}"/><Run x:Name="ReadSenderAddress" FontSize="13" Foreground="{ThemeResource SecondaryBrush}"/></TextBlock><TextBlock x:Name="ReadToSummary" Foreground="{ThemeResource SecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock x:Name="ReadCcSummary" Foreground="{ThemeResource SecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel><Button x:Name="ReadDetailsButton" Grid.Column="2" Content="详情" Click="ReadDetails_Click" Padding="8,4" VerticalAlignment="Top"/></Grid><Border x:Name="ReadDetailsPanel" Visibility="Collapsed" Background="{ThemeResource GroupBrush}" CornerRadius="6" Padding="14,10"><StackPanel Spacing="5"><TextBlock x:Name="ReadSender" TextWrapping="Wrap"/><TextBlock x:Name="ReadTo" TextWrapping="Wrap"/><TextBlock x:Name="ReadCc" TextWrapping="Wrap"/><TextBlock x:Name="ReadDetailSubject" TextWrapping="Wrap"/><TextBlock x:Name="ReadDate" TextWrapping="Wrap"/></StackPanel></Border><Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1" Margin="0,4,0,0"/></StackPanel>
<Grid Grid.Row="2"><ScrollViewer x:Name="PlainScroll" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ReadBody" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer><WebView2 x:Name="HtmlView" Visibility="Collapsed"/></Grid>
<StackPanel x:Name="AttachmentPanel" Grid.Row="3" Visibility="Collapsed" Spacing="8" MaxHeight="200"><Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0"/><TextBlock x:Name="AttachmentHeading" FontWeight="SemiBold"/><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="AttachmentList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,8,8"><Grid ColumnDefinitions="*,Auto"><Button Click="Attachment_Click" Tag="{Binding}" Padding="10,8" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="预览附件"><StackPanel Orientation="Horizontal" Spacing="8"><Border Width="36" Height="42" CornerRadius="4" Background="{Binding TypeBrush}"><Grid><TextBlock Text="{Binding TypeLabel}" Visibility="{Binding TypeLabelVisibility}" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/><FontIcon Glyph="&#xEB9F;" Visibility="{Binding ImageIconVisibility}" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" MaxWidth="160" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SizeLabel}" FontSize="11" Foreground="{ThemeResource MutedBrush}"/></StackPanel></StackPanel></Button><Button Grid.Column="1" Tag="{Binding}" Click="AttachmentMenu_Click" Padding="8" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" AutomationProperties.Name="附件操作" ToolTipService.ToolTip="附件操作"><FontIcon Glyph="&#xE712;" FontSize="16"/></Button></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Grid>
<Grid x:Name="PreviewWorkspace" Grid.Row="1" Visibility="Collapsed" Padding="24" RowDefinitions="Auto,*" RowSpacing="16"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Button Click="BackFromPreview_Click" Width="48" Height="48" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTipService.ToolTip="返回邮件正文" AutomationProperties.Name="返回邮件正文"><FontIcon Glyph="&#xE72B;" FontSize="24"/></Button><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="PreviewName" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PreviewSize" Foreground="{ThemeResource MutedBrush}" FontSize="12"/></StackPanel><Button Grid.Column="2" Content="另存为" Click="SaveAttachment_Click"/></Grid><Grid Grid.Row="1"><Grid x:Name="PreviewSurface" SizeChanged="PreviewSurface_SizeChanged"><Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"/></Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" IsHitTestVisible="False"><ProgressRing x:Name="PreviewProgress" Width="48" Height="48" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center"/><TextBlock x:Name="PreviewMessage" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource MutedBrush}"/></StackPanel></Grid></Grid>
<Grid x:Name="ComposeWorkspace" Grid.Row="1" Visibility="Collapsed" Padding="18" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="12">
<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled"><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SendButton" Content="➤ 发送" Click="Send_Click" Background="#2863CF" Foreground="White"/><Button Content="保存草稿" IsEnabled="False"/><Button Content="丢弃" Click="CloseCompose_Click"/></StackPanel></ScrollViewer><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"><Button Click="ComposeAttachment_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE723;" FontSize="15"/><TextBlock Text="添加附件"/></StackPanel></Button><Button Click="ComposeAi_Click" Background="#FFF4E5" BorderBrush="#E7A95D" Foreground="#A65800"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE945;" FontSize="15"/><TextBlock Text="AI 帮我写"/></StackPanel></Button></StackPanel></Grid>
<Grid Grid.Row="1" ColumnDefinitions="60,*" ColumnSpacing="8"><TextBlock Text="发件人" VerticalAlignment="Center"/><ComboBox x:Name="FromBox" Grid.Column="1" HorizontalAlignment="Stretch" PlaceholderText="请先配置邮箱" AutomationProperties.Name="发件人"/></Grid>
<Grid Grid.Row="2" ColumnDefinitions="60,*" ColumnSpacing="8"><TextBlock Text="收件人" VerticalAlignment="Center"/><TextBox x:Name="ToBox" Grid.Column="1" PlaceholderText="输入邮箱地址" AutomationProperties.Name="收件人"/></Grid>
<Grid Grid.Row="3" ColumnDefinitions="60,*" ColumnSpacing="8"><TextBlock Text="抄送" VerticalAlignment="Center"/><TextBox x:Name="CcBox" Grid.Column="1" PlaceholderText="输入抄送地址" AutomationProperties.Name="抄送"/></Grid>
<Grid Grid.Row="4" ColumnDefinitions="60,*" ColumnSpacing="8"><TextBlock Text="主题" VerticalAlignment="Center"/><TextBox x:Name="SubjectBox" Grid.Column="1" PlaceholderText="添加主题" AutomationProperties.Name="主题"/></Grid>
<Grid Grid.Row="5" RowDefinitions="Auto,*"><Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1,1,1,0" Padding="4"><ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled"><StackPanel Orientation="Horizontal" Spacing="2"><TextBlock Text="正文" VerticalAlignment="Center" Margin="6,0,10,0"/><ComboBox x:Name="FontBox" SelectedIndex="0" Width="120" PlaceholderText="字体" SelectionChanged="FontBox_SelectionChanged" AutomationProperties.Name="字体"><ComboBoxItem Content="微软雅黑" Tag="Microsoft YaHei"/><ComboBoxItem Content="宋体" Tag="SimSun"/><ComboBoxItem Content="黑体" Tag="SimHei"/><ComboBoxItem Content="等线" Tag="DengXian"/><ComboBoxItem Content="Arial" Tag="Arial"/><ComboBoxItem Content="Calibri" Tag="Calibri"/><ComboBoxItem Content="Times New Roman" Tag="Times New Roman"/></ComboBox><ComboBox x:Name="FontSizeBox" SelectedIndex="2" Width="88" PlaceholderText="字号" SelectionChanged="FontSizeBox_SelectionChanged" AutomationProperties.Name="字号"><ComboBoxItem Content="10 px" Tag="1"/><ComboBoxItem Content="13 px" Tag="2"/><ComboBoxItem Content="16 px" Tag="3"/><ComboBoxItem Content="18 px" Tag="4"/><ComboBoxItem Content="24 px" Tag="5"/><ComboBoxItem Content="32 px" Tag="6"/><ComboBoxItem Content="48 px" Tag="7"/></ComboBox><Button Content="B" FontWeight="Bold" Click="FormatBold_Click" ToolTipService.ToolTip="粗体" AutomationProperties.Name="粗体"/><Button Content="I" FontStyle="Italic" Click="FormatItalic_Click" ToolTipService.ToolTip="斜体" AutomationProperties.Name="斜体"/><Button Content="U" Click="FormatUnderline_Click" ToolTipService.ToolTip="下划线" AutomationProperties.Name="下划线"/><Button Content="• ☰" Click="FormatBullet_Click" ToolTipService.ToolTip="项目符号" AutomationProperties.Name="项目符号"/><Button Content="1. ☰" Click="FormatNumber_Click" ToolTipService.ToolTip="编号列表" AutomationProperties.Name="编号列表"/><Button x:Name="TableButton" Click="InsertTable_Click" ToolTipService.ToolTip="插入表格" AutomationProperties.Name="插入表格"><FontIcon Glyph="&#xE80A;" FontSize="16"/></Button><Button Click="FormatLeft_Click" ToolTipService.ToolTip="左对齐" AutomationProperties.Name="左对齐"><FontIcon Glyph="&#xE8E4;" FontSize="16"/></Button><Button Click="FormatCenter_Click" ToolTipService.ToolTip="居中" AutomationProperties.Name="居中"><FontIcon Glyph="&#xE8E3;" FontSize="16"/></Button><Button Click="FormatRight_Click" ToolTipService.ToolTip="右对齐" AutomationProperties.Name="右对齐"><FontIcon Glyph="&#xE8E2;" FontSize="16"/></Button></StackPanel></ScrollViewer></Border><WebView2 x:Name="BodyBox" Grid.Row="1" AutomationProperties.Name="邮件正文"/></Grid>
</Grid></Grid>
<Border x:Name="AiPane" Grid.Column="3" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1,0,0,0" Background="{ThemeResource PanelBrush}"><Grid Padding="18,48,18,20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="AI 助手" FontSize="22" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="未配置" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center"/></Grid><StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><Button Content="总结此邮件" IsEnabled="False"/><Button Content="回复此邮件" IsEnabled="False"/></StackPanel><Border Grid.Row="2" Background="{ThemeResource NoteBackgroundBrush}" CornerRadius="10" Padding="14" VerticalAlignment="Top"><TextBlock Text="配置 AI 服务后，可以帮助你总结邮件和起草回复。" TextWrapping="Wrap" Foreground="{ThemeResource NoteTextBrush}"/></Border><TextBox Grid.Row="3" PlaceholderText="输入问题或指令..." IsEnabled="False" AcceptsReturn="True" Height="90"/></Grid></Border>
<local:ColumnSplitter Grid.Column="0" Width="8" HorizontalAlignment="Right" Background="Transparent" PointerPressed="Splitter_PointerPressed" PointerMoved="Splitter_PointerMoved" PointerReleased="Splitter_PointerReleased" PointerCaptureLost="Splitter_PointerCaptureLost" Tag="0" ToolTipService.ToolTip="拖动调整栏目宽度"/><local:ColumnSplitter Grid.Column="1" Width="8" HorizontalAlignment="Right" Background="Transparent" PointerPressed="Splitter_PointerPressed" PointerMoved="Splitter_PointerMoved" PointerReleased="Splitter_PointerReleased" PointerCaptureLost="Splitter_PointerCaptureLost" Tag="1" ToolTipService.ToolTip="拖动调整栏目宽度"/><local:ColumnSplitter x:Name="AiSplitter" Grid.Column="2" Width="8" HorizontalAlignment="Right" Background="Transparent" PointerPressed="Splitter_PointerPressed" PointerMoved="Splitter_PointerMoved" PointerReleased="Splitter_PointerReleased" PointerCaptureLost="Splitter_PointerCaptureLost" Tag="2" ToolTipService.ToolTip="拖动调整栏目宽度"/><Button x:Name="AiToggleButton" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" Click="ToggleAi_Click" ToolTipService.ToolTip="收起 AI 助手" AutomationProperties.Name="收起 AI 助手"><Grid><FontIcon x:Name="AiToggleIcon" Visibility="Collapsed"/><TextBlock Text="&gt;|" FontSize="16" Foreground="{ThemeResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button>
<local:AiFloatingButton x:Name="AiFloatingButton" Grid.Column="2" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,22" Width="60" Height="60" Padding="0" CornerRadius="30" Background="Transparent" BorderThickness="0" Click="ToggleAi_Click" ToolTipService.ToolTip="打开 AI 助手" AutomationProperties.Name="打开 AI 助手"><Image Source="ms-appx:///Assets/MailMindAI-A-224.png" Width="60" Height="60" Stretch="Uniform"/></local:AiFloatingButton>
</Grid>
<Border x:Name="SendStatusBanner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" Padding="16,10" CornerRadius="8" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1" Canvas.ZIndex="100"><StackPanel Orientation="Horizontal" Spacing="10"><ProgressRing x:Name="SendProgress" Width="18" Height="18" IsActive="False"/><FontIcon x:Name="SendResultIcon" Visibility="Collapsed" FontSize="18" VerticalAlignment="Center"/><TextBlock x:Name="SendStatusText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="500"/></StackPanel></Border></Grid></Window>







