<Window x:Class="MailMind.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MailMind">
<Grid Background="#F7F7F7">
<Grid.Resources><Style x:Key="SidebarButtonStyle" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#17233A"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="14,10"/><Setter Property="CornerRadius" Value="6"/></Style></Grid.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="AiColumn" Width="320"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#F5F5F5" BorderBrush="#DFE2E8" BorderThickness="0,0,1,0"><Grid Padding="16,16,16,20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
<StackPanel Orientation="Horizontal" Spacing="10" Margin="4,0,0,0"><Image Source="ms-appx:///Assets/MailMind.png" Width="42" Height="42"/><StackPanel VerticalAlignment="Center"><TextBlock Text="智邮" FontSize="18" FontWeight="SemiBold" Foreground="#17233A"/><TextBlock Text="让邮件回归清晰" FontSize="11" Foreground="#788399"/></StackPanel></StackPanel>
<Grid x:Name="DragRegion" Background="Transparent"/>
<Grid Grid.Row="1" ColumnDefinitions="*,Auto"><Button Content="✎  写邮件" Click="Compose_Click" Background="#2863CF" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,10" FontSize="16"/><Button Grid.Column="1" Content="⟳" Click="Refresh_Click" Background="Transparent" FontSize="22"/></Grid>
<ScrollViewer Grid.Row="2" Margin="0,0,-12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><StackPanel HorizontalAlignment="Stretch" Margin="0,0,12,0"><TextBlock x:Name="NoAccountHint" Text="尚未添加邮箱" Foreground="#788399"/><Expander x:Name="AccountExpander" Visibility="Collapsed" IsExpanded="True" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><Expander.Header><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="●" Foreground="#48B84B"/><TextBlock x:Name="AccountLabel" Text="尚未连接邮箱" MaxWidth="150" TextTrimming="CharacterEllipsis"/></StackPanel></Expander.Header><StackPanel x:Name="FolderList" Spacing="2" HorizontalAlignment="Stretch"/></Expander></StackPanel></ScrollViewer>
<Button Grid.Row="3" Style="{StaticResource SidebarButtonStyle}" Click="Settings_Click" Content="⚙   配置" HorizontalAlignment="Stretch"/>
</Grid></Border>
<Border Grid.Column="1" BorderBrush="#DFE2E8" BorderThickness="0,0,1,0" Background="#FAFAFA"><Grid RowDefinitions="Auto,Auto,*"><Grid Padding="12,16" ColumnDefinitions="*,40,70" ColumnSpacing="6"><Grid><TextBox x:Name="SearchBox" PlaceholderText="搜索邮件" Padding="34,8,8,8" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Height="40" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="搜索邮件"/><FontIcon Glyph="&#xE721;" FontSize="15" Foreground="#59677D" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/></Grid><Button x:Name="DateFilterButton" Grid.Column="1" Width="40" Height="40" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTipService.ToolTip="按日期筛选已加载邮件" AutomationProperties.Name="按日期筛选邮件"><FontIcon Glyph="&#xE787;" FontSize="17"/><Button.Flyout><Flyout Placement="Bottom"><StackPanel Spacing="8"><TextBlock Text="选择邮件日期" FontWeight="SemiBold"/><CalendarView x:Name="SearchCalendar" SelectionMode="Single" SelectedDatesChanged="SearchCalendar_SelectedDatesChanged"/><Button Content="清除日期筛选" Click="ClearDateFilter_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/></StackPanel></Flyout></Button.Flyout></Button><ToggleButton Grid.Column="2" Width="70" Height="40" Padding="0" IsEnabled="False" ToolTipService.ToolTip="AI 搜索尚未配置" AutomationProperties.Name="AI 搜索，尚未配置"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#EEF4FF" BorderBrush="#BFD3F5" BorderThickness="1" CornerRadius="7"><StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="AI" FontWeight="SemiBold" Foreground="#192337"/><Grid Width="28" Height="16"><Border Background="#2863CF" CornerRadius="8"/><Ellipse Width="12" Height="12" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0"/></Grid></StackPanel></Border></ControlTemplate></ToggleButton.Template></ToggleButton></Grid><StackPanel Grid.Row="1" Background="#F0F1F3" Padding="14,7"><TextBlock x:Name="FolderTitle" Text="收件箱" Foreground="#59677D"/><TextBlock x:Name="ListStatus" Text="连接邮箱后查看邮件" Foreground="#788399" FontSize="11" TextWrapping="Wrap"/></StackPanel><Grid Grid.Row="2"><ListView x:Name="MailList" SelectionChanged="MailList_SelectionChanged" Loaded="MailList_Loaded" LayoutUpdated="MailList_LayoutUpdated" SizeChanged="MailList_SizeChanged" ContainerContentChanging="MailList_ContainerContentChanging" HorizontalContentAlignment="Stretch"><ListView.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Border Background="#F0F1F3" Padding="14,7" HorizontalAlignment="Stretch"><TextBlock Text="{Binding Title}" Foreground="#59677D" FontSize="12"/></Border></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListView.GroupStyle><ListView.Template><ControlTemplate TargetType="ListView"><ScrollViewer VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" Loaded="MailScroll_Loaded" ViewChanged="ListScroll_ViewChanged"><ItemsPresenter/></ScrollViewer></ControlTemplate></ListView.Template><ListView.ItemTemplate><DataTemplate><Grid Padding="4,10" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8"><Ellipse Width="8" Height="8" Fill="#2863CF" VerticalAlignment="Top" Margin="0,8,0,0" Visibility="{Binding UnreadVisibility}"/><Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#E1EBFC" VerticalAlignment="Top"><FontIcon Glyph="&#xE715;" FontSize="16" Foreground="#2863CF"/></Border><StackPanel Grid.Column="2" Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Sender}" FontWeight="{Binding MailWeight}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Date}" FontSize="11" Foreground="#788399"/></Grid><TextBlock Text="{Binding Subject}" FontWeight="{Binding MailWeight}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Preview}" Foreground="#788399" FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView><TextBlock x:Name="ListEmptyText" Text="还没有邮件" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#788399"/></Grid></Grid></Border>
<Grid Grid.Column="2" RowDefinitions="Auto,*"><Border x:Name="ReadingToolbar" BorderBrush="#E0E3E8" BorderThickness="0,0,0,1" Padding="18,14"><ItemsControl><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.Items><Button IsEnabled="False" Margin="0,0,10,8"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE97A;" FontSize="16"/><TextBlock Text="回复"/></StackPanel></Button><Button IsEnabled="False" Margin="0,0,10,8"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE97B;" FontSize="16"/><TextBlock Text="全部回复"/></StackPanel></Button><Button IsEnabled="False" Margin="0,0,10,8"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72A;" FontSize="16"/><TextBlock Text="转发"/></StackPanel></Button><Button IsEnabled="False" Margin="0,0,10,8"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="16"/><TextBlock Text="删除"/></StackPanel></Button><Button IsEnabled="False" Margin="0,0,10,8"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7B8;" FontSize="16"/><TextBlock Text="归档"/></StackPanel></Button></ItemsControl.Items></ItemsControl></Border>
<StackPanel x:Name="EmptyWorkspace" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16"><FontIcon Glyph="&#xE715;" FontSize="64" Foreground="#A4ADBB" HorizontalAlignment="Center"/><TextBlock Text="选择一封邮件开始阅读" FontSize="20" Foreground="#8B95A5"/><Button Content="✎  写邮件" Click="Compose_Click" Background="#2863CF" Foreground="White" HorizontalAlignment="Center"/></StackPanel>
<Grid x:Name="ReadingWorkspace" Grid.Row="1" Visibility="Collapsed" Padding="24,24,24,12" RowDefinitions="Auto,Auto,*" RowSpacing="16"><TextBlock x:Name="ReadSubject" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ReadSender" Grid.Row="1" Foreground="#65728A" TextWrapping="Wrap"/><Grid Grid.Row="2"><ScrollViewer x:Name="PlainScroll" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ReadBody" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer><WebView2 x:Name="HtmlView" Visibility="Collapsed"/></Grid></Grid>
<Grid x:Name="ComposeWorkspace" Grid.Row="1" Visibility="Collapsed" Padding="20" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12"><TextBlock Text="新邮件" FontSize="24" FontWeight="SemiBold"/><TextBox x:Name="ToBox" Grid.Row="1" Header="收件人" PlaceholderText="输入邮箱地址"/><TextBox x:Name="SubjectBox" Grid.Row="2" Header="主题" PlaceholderText="添加主题"/><TextBox x:Name="BodyBox" Grid.Row="3" Header="正文" PlaceholderText="开始写作..." AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/><StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10"><Button Content="发送" Click="Send_Click" Background="#2863CF" Foreground="White"/><Button Content="丢弃" Click="CloseCompose_Click"/></StackPanel></Grid></Grid>
<Border x:Name="AiPane" Grid.Column="3" BorderBrush="#DFE2E8" BorderThickness="1,0,0,0" Background="#FAFAFA"><Grid Padding="18,40,18,20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="AI 助手" FontSize="22" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="未配置" Foreground="#788399" VerticalAlignment="Center"/></Grid><StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><Button Content="总结此邮件" IsEnabled="False"/><Button Content="回复此邮件" IsEnabled="False"/></StackPanel><Border Grid.Row="2" Background="#FFF5E5" CornerRadius="10" Padding="14" VerticalAlignment="Top"><TextBlock Text="配置 AI 服务后，可以帮助你总结邮件和起草回复。" TextWrapping="Wrap" Foreground="#4D5667"/></Border><TextBox Grid.Row="3" PlaceholderText="输入问题或指令..." IsEnabled="False" AcceptsReturn="True" Height="90"/></Grid></Border>
<Button x:Name="AiToggleButton" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0" Width="32" Height="48" Padding="0" CornerRadius="8,0,0,8" Background="#FFFFFF" BorderBrush="#DFE2E8" Click="ToggleAi_Click" ToolTipService.ToolTip="收起 AI 助手" AutomationProperties.Name="收起 AI 助手"><FontIcon x:Name="AiToggleIcon" Glyph="&#xE76C;" FontSize="14" Foreground="#53647C"/></Button>
<Button x:Name="AiFloatingButton" Grid.Column="2" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,22" Width="60" Height="60" Padding="0" CornerRadius="30" Background="#D99426" BorderBrush="White" BorderThickness="3" Click="ToggleAi_Click" ToolTipService.ToolTip="打开 AI 助手" AutomationProperties.Name="打开 AI 助手"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0"><FontIcon Glyph="&#xE945;" FontSize="18" Foreground="White"/><TextBlock Text="AI" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/></StackPanel></Button>
</Grid>
</Grid></Window>







